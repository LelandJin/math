General:
  ConfigurationType: StaticLibrary
  UseOfMfc: false
  IntDir: ../temp/CcpMath/$(Platform)/$(Configuration)/$(PlatformToolset)/
  OutDir: ../../autobuild/CcpMath/$(Platform)/$(PlatformToolset)/
  TargetExt: .lib

ClCompile:
  EnableEnhancedInstructionSet: StreamingSIMDExtensions2
  PrecompiledHeader: NotUsing
  DebugInformationFormat: OldStyle
  WarningLevel: Level3
  TreatWarningAsError: true
  BufferSecurityCheck: false
  FloatingPointModel: Fast
  AdditionalIncludeDirectories:
  - .

Link:
  GenerateDebugInformation: true

BaseConfigurations:
  DebugBase:
    ClCompile:
      PreprocessorDefinitions:
      - _DEBUG
      Optimization: Disabled
      RuntimeLibrary: MultiThreadedDebugDLL

  ReleaseBase:
    ClCompile:
      Optimization: MaxSpeed
      RuntimeLibrary: MultiThreadedDLL

  CodeCoverage:
    General: 
      GenerateCodeCoverage: true
    ClCompile:
      PreprocessorDefinitions:
      - NDEBUG
      Optimization: Disabled
      RuntimeLibrary: MultiThreadedDLL
      DebugInformationFormat: ProgramDatabase

Configurations:
  Debug|Win32,x64:
    BaseConfigurations:
    - DebugBase
    General: 
      TargetName: CcpMath_d

  Debug|Linux32,Linux64,Mac32,Mac64:
    BaseConfigurations:
    - DebugBase
    General: 
      TargetName: CcpMath_d

  Release|Win32,x64:
    BaseConfigurations:
    - ReleaseBase
    General:
      TargetName: CcpMath

  Release|Linux32,Linux64,Mac32,Mac64:
    BaseConfigurations:
    - ReleaseBase
    General:
      TargetName: CcpMath

  Release_Coverage|Mac32,Mac64:
    BaseConfigurations:
    - CodeCoverage
    General:
      TargetName: CcpMath_cc
